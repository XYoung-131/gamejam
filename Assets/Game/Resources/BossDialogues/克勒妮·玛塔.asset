  m_Script: {fileID: 11500000, guid: ea96bc02e2f8481a9b2be0600ba5ee90, type: 3}
  m_Name: "\u514B\u52D2\u59AE\xB7\u739B\u5854"
  m_EditorClassIdentifier: 
  unitName: "\u514B\u52D2\u59AE\xB7\u739B\u5854"
  seenKey: 
  charactersPerSecond: 45
  leftName: "\u4E3B"
  leftPortrait: {fileID: 21300000, guid: 7a3c5e91b2d44f0e8c6105d9a4b73e21, type: 3}
  leftPortraitHeight: 960
  rightName: "\u514B"
  rightPortrait: {fileID: 21300000, guid: c1ed512b9270426fba28ccb044066947, type: 3}
  rightPortraitHeight: 960
  firstEncounter:
  - speaker: "\u514B"
    text: "\u65E9\u4E0A\u597D\u554A\u52D2\u5FD2\uFF0C\u4F60\u4ECA\u5929\u8BB0\u5F97\u6211\u5417\uFF1F"
  - speaker: "\u4E3B"
    text: "\u2026\u2026"
  - speaker: "\u4E3B"
    text: "\u6CA1\u5370\u8C61\u3002"
  - speaker: "\u514B"
    text: "\u771F\u7684\u5417\uFF1F\u4F60\u518D\u60F3\u60F3\uFF0C\u6211\u6628\u5929\u8FD8\u9080\u8BF7\u4F60\u4E00\u8D77\u5171\u8FDB\u65E9\u9910\u6765\u7740\uFF0C\u4F60\u8FD8\u662F\u628A\u6211\u5FD8\u4E86\u5417\uFF1F"
  - speaker: "\u4E3B"
    text: "\u771F\u6CA1\u5370\u8C61\u3002"
  - speaker: "\u514B"
    text: "\u597D\u5427\uFF0C\u90A3\u6211\u518D\u81EA\u6211\u4ECB\u7ECD\u4E00\u4E0B\u5427\uFF0C\u6211\u53EB\u514B\u52D2\u59AE\xB7\u739B\u5854\uFF0C\u8FD9\u4E9B\u6BDB\u8338\u8338\u7684\u5C0F\u5BB6\u4F19\u90FD\u662F\u6211\u7684\u670B\u53CB\u3002"
  - speaker: "\u4E3B"
    text: "\u4F60\u7684\u670B\u53CB\u5DEE\u70B9\u8981\u4E86\u6211\u7684\u547D\u3002"
  - speaker: "\u514B"
    text: "\u6211\u66FF\u4ED6\u4EEC\u8BF4\u58F0\u62B1\u6B49\uFF0C\u4F46\u67B6\u8FD8\u662F\u8981\u6253\u7684\uFF0C\u8981\u4E0D\u4F60\u76F4\u63A5\u8BA4\u8F93\uFF0C\u6211\u4EEC\u8FD8\u6709\u65F6\u95F4\u559D\u4E0B\u5348\u8336\u3002"
  - speaker: "\u4E3B"
    text: "\u2026\u2026"
  - speaker: "\u4E3B"
    text: "\u4E0D\u80FD\u3002"
  - speaker: "\u514B"
    text: "\u90A3\u597D\u5427\uFF0C\u5E0C\u671B\u6253\u5B8C\u4E4B\u540E\uFF0C\u4F60\u80FD\u591A\u8BB0\u4F4F\u6211\u4E00\u70B9\u3002"
  repeatEncounter:
  - speaker: "\u514B"
    text: "\u4F60\u597D\u554A\u52D2\u5FD2\uFF0C\u4F60\u4ECA\u5929\u8BB0\u5F97\u6211\u5417\uFF1F"
  - speaker: "\u4E3B"
    text: "\u6709\u70B9\u5370\u8C61\uFF0C\u4F60\u662F\u2026\u2026"
  - speaker: "\u4E3B"
    text: "\u5636\uFF0C\u6211\u8111\u6D77\u4E2D\u6709\u597D\u591A\u4E2A\u540D\u5B57\uFF0C\u4F60\u662F\u54EA\u4E2A\u6765\u7740\u2026\u2026"
  - speaker: "\u514B"
    text: "\u514B\u52D2\u59AE\xB7\u739B\u5854\u3002"
  - speaker: "\u4E3B"
    text: "\u55EF\uFF0C\u5BF9\uFF0C\u739B\u5854\u3002"
  - speaker: "\u514B"
    text: "\u4F60\u8FD8\u771F\u8BB0\u4F4F\u4E86\u4E00\u70B9\uFF0C\u5E0C\u671B\u8FD9\u6B21\u6253\u5B8C\u4E4B\u540E\uFF0C\u4F60\u80FD\u591A\u8BB0\u4F4F\u6211\u4E00\u70B9\u3002"
  victory:
  - speaker: "\u514B"
    text: "\u4F60\u8D62\u4E86\uFF0C\u52D2\u5FD2\u3002\u867D\u7136\u6211\u4E0D\u80FD\u4F53\u4F1A\u53CD\u590D\u8BB0\u5FC6\u548C\u5931\u53BB\u7684\u75DB\u82E6\uFF0C\u4F46\u6211\u8BB0\u5F97\u6BCF\u4E00\u53EA\u6B7B\u53BB\u670B\u53CB\u7684\u6837\u5B50\uFF0C\u6211\u4EEC\u7684\u75DB\u82E6\u4E5F\u8BB8\u662F\u76F8\u901A\u7684\u5462\u3002"
  - speaker: "\u4E3B"
    text: "\u4E5F\u8BB8\u5427\uFF0C\u518D\u89C1\uFF0C\u6211\u4E0B\u6B21\u4F1A\u8BB0\u4F4F\u4F60\u7684\u3002"
